# Satu instance MongoDB; tiap bounded context = database terpisah.
# Host = service `mongo` di docker-compose.yml, port 27017.
# Tiap microservice membaca <MODULE>_DB_HOST/_PORT/_NAME di instance yang sama.
DB_MIGRATE_HOST=mongo
DB_MIGRATE_PORT=27017
DB_MIGRATE_NAME=ec_identity

# identity context → ec_identity
ROLE_DB_HOST=mongo
ROLE_DB_PORT=27017
ROLE_DB_NAME=ec_identity
USER_DB_HOST=mongo
USER_DB_PORT=27017
USER_DB_NAME=ec_identity
AUTH_DB_HOST=mongo
AUTH_DB_PORT=27017
AUTH_DB_NAME=ec_identity
# merchant context → ec_merchant
MERCHANT_DB_HOST=mongo
MERCHANT_DB_PORT=27017
MERCHANT_DB_NAME=ec_merchant
MERCHANT_AWARD_DB_HOST=mongo
MERCHANT_AWARD_DB_PORT=27017
MERCHANT_AWARD_DB_NAME=ec_merchant
MERCHANT_BUSINESS_DB_HOST=mongo
MERCHANT_BUSINESS_DB_PORT=27017
MERCHANT_BUSINESS_DB_NAME=ec_merchant
MERCHANT_DETAIL_DB_HOST=mongo
MERCHANT_DETAIL_DB_PORT=27017
MERCHANT_DETAIL_DB_NAME=ec_merchant
MERCHANT_POLICY_DB_HOST=mongo
MERCHANT_POLICY_DB_PORT=27017
MERCHANT_POLICY_DB_NAME=ec_merchant
MERCHANT_SOCIAL_LINK_DB_HOST=mongo
MERCHANT_SOCIAL_LINK_DB_PORT=27017
MERCHANT_SOCIAL_LINK_DB_NAME=ec_merchant
# catalog context → ec_catalog
CATEGORY_DB_HOST=mongo
CATEGORY_DB_PORT=27017
CATEGORY_DB_NAME=ec_catalog
PRODUCT_DB_HOST=mongo
PRODUCT_DB_PORT=27017
PRODUCT_DB_NAME=ec_catalog
BANNER_DB_HOST=mongo
BANNER_DB_PORT=27017
BANNER_DB_NAME=ec_catalog
SLIDER_DB_HOST=mongo
SLIDER_DB_PORT=27017
SLIDER_DB_NAME=ec_catalog
# sales context → ec_sales
ORDER_DB_HOST=mongo
ORDER_DB_PORT=27017
ORDER_DB_NAME=ec_sales
ORDER_ITEM_DB_HOST=mongo
ORDER_ITEM_DB_PORT=27017
ORDER_ITEM_DB_NAME=ec_sales
TRANSACTION_DB_HOST=mongo
TRANSACTION_DB_PORT=27017
TRANSACTION_DB_NAME=ec_sales
# experience context → ec_experience
CART_DB_HOST=mongo
CART_DB_PORT=27017
CART_DB_NAME=ec_experience
REVIEW_DB_HOST=mongo
REVIEW_DB_PORT=27017
REVIEW_DB_NAME=ec_experience
REVIEW_DETAIL_DB_HOST=mongo
REVIEW_DETAIL_DB_PORT=27017
REVIEW_DETAIL_DB_NAME=ec_experience
SHIPPING_ADDRESS_DB_HOST=mongo
SHIPPING_ADDRESS_DB_PORT=27017
SHIPPING_ADDRESS_DB_NAME=ec_experience
# email context → ec_email
EMAIL_DB_HOST=mongo
EMAIL_DB_PORT=27017
EMAIL_DB_NAME=ec_email

DB_SEEDER=true

SECRET_KEY=CHANGE_ME_SECRET_KEY

KAFKA_BROKERS=kafka:9092

APP_ENV=docker
APP_LOGGER=production

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

OTEL_ENDPOINT=otel-collector:4317


APP_ENV=docker

# --- MongoDB: satu instance; tiap bounded context = database terpisah ---
# Host = nama service `mongo` di docker-compose.yml, port 27017.
# Tiap microservice membaca <MODULE>_DB_HOST/_PORT/_NAME di instance yang sama.
DB_MIGRATE_HOST=mongo
DB_MIGRATE_PORT=27017
DB_MIGRATE_NAME=ec_identity

# identity context → ec_identity
ROLE_DB_HOST=mongo
ROLE_DB_PORT=27017
ROLE_DB_NAME=ec_identity
USER_DB_HOST=mongo
USER_DB_PORT=27017
USER_DB_NAME=ec_identity
AUTH_DB_HOST=mongo
AUTH_DB_PORT=27017
AUTH_DB_NAME=ec_identity
# merchant context → ec_merchant
MERCHANT_DB_HOST=mongo
MERCHANT_DB_PORT=27017
MERCHANT_DB_NAME=ec_merchant
MERCHANT_AWARD_DB_HOST=mongo
MERCHANT_AWARD_DB_PORT=27017
MERCHANT_AWARD_DB_NAME=ec_merchant
MERCHANT_BUSINESS_DB_HOST=mongo
MERCHANT_BUSINESS_DB_PORT=27017
MERCHANT_BUSINESS_DB_NAME=ec_merchant
MERCHANT_DETAIL_DB_HOST=mongo
MERCHANT_DETAIL_DB_PORT=27017
MERCHANT_DETAIL_DB_NAME=ec_merchant
MERCHANT_POLICY_DB_HOST=mongo
MERCHANT_POLICY_DB_PORT=27017
MERCHANT_POLICY_DB_NAME=ec_merchant
MERCHANT_SOCIAL_LINK_DB_HOST=mongo
MERCHANT_SOCIAL_LINK_DB_PORT=27017
MERCHANT_SOCIAL_LINK_DB_NAME=ec_merchant
# catalog context → ec_catalog
CATEGORY_DB_HOST=mongo
CATEGORY_DB_PORT=27017
CATEGORY_DB_NAME=ec_catalog
PRODUCT_DB_HOST=mongo
PRODUCT_DB_PORT=27017
PRODUCT_DB_NAME=ec_catalog
BANNER_DB_HOST=mongo
BANNER_DB_PORT=27017
BANNER_DB_NAME=ec_catalog
SLIDER_DB_HOST=mongo
SLIDER_DB_PORT=27017
SLIDER_DB_NAME=ec_catalog
# sales context → ec_sales
ORDER_DB_HOST=mongo
ORDER_DB_PORT=27017
ORDER_DB_NAME=ec_sales
ORDER_ITEM_DB_HOST=mongo
ORDER_ITEM_DB_PORT=27017
ORDER_ITEM_DB_NAME=ec_sales
TRANSACTION_DB_HOST=mongo
TRANSACTION_DB_PORT=27017
TRANSACTION_DB_NAME=ec_sales
# experience context → ec_experience
CART_DB_HOST=mongo
CART_DB_PORT=27017
CART_DB_NAME=ec_experience
REVIEW_DB_HOST=mongo
REVIEW_DB_PORT=27017
REVIEW_DB_NAME=ec_experience
REVIEW_DETAIL_DB_HOST=mongo
REVIEW_DETAIL_DB_PORT=27017
REVIEW_DETAIL_DB_NAME=ec_experience
SHIPPING_ADDRESS_DB_HOST=mongo
SHIPPING_ADDRESS_DB_PORT=27017
SHIPPING_ADDRESS_DB_NAME=ec_experience
# email context → ec_email
EMAIL_DB_HOST=mongo
EMAIL_DB_PORT=27017
EMAIL_DB_NAME=ec_email


SECRET_KEY=k8s-fase8-local-9f3a7c1e5b2d8a4f6c0e3b7d1a5f9c2e

KAFKA_BROKERS=kafka:9092

# Outbox relays (transaction/order/merchant) publish stats.*.event to this broker.
spring.kafka.bootstrap-servers=kafka:9092

APP_LOGGER=production

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=dragon_knight
REDIS_HOST_APIGATEWAY=redis
REDIS_PORT_APIGATEWAY=6379
REDIS_PASSWORD_APIGATEWAY=dragon_knight
REDIS_DB_APIGATEWAY=19

OTEL_ENDPOINT=localhost:4317

GRPC_AUTH_ADDR=auth:50051
GRPC_ROLE_ADDR=role:50052
GRPC_USER_ADDR=user:50053
GRPC_CATEGORY_ADDR=category:50054
GRPC_MERCHANT_ADDR=merchant:50055
GRPC_ORDER_ITEM_ADDR=order_item:50056
GRPC_ORDER_ADDR=order:50057
GRPC_PRODUCT_ADDR=product:50058
GRPC_TRANSACTION_ADDR=transaction:50059
GRPC_CART_ADDR=cart:50060
GRPC_REVIEW_ADDR=review:50061
GRPC_SLIDER_ADDR=slider:50062
GRPC_SHIPPING_ADDR=shipping:50063
GRPC_BANNER_ADDR=banner:50064
GRPC_MERCHANT_AWARD_ADDR=merchant_award:50065
GRPC_MERCHANT_BUSINESS_ADDR=merchant_business:50066
GRPC_MERCHANT_DETAIL_ADDR=merchant_detail:50067
GRPC_MERCHANT_POLICY_ADDR=merchant_policy:50068
GRPC_REVIEW_DETAIL_ADDR=review_detail:50069

# Stats pipeline (ClickHouse + stats-reader gRPC).
# CLICKHOUSE_ADDR/DATABASE/USERNAME are legacy Vert.x-era keys; the Spring Boot
# services read `clickhouse.url`/`clickhouse.username`/`clickhouse.password`
# (relaxed binding maps CLICKHOUSE_USERNAME/PASSWORD above).
CLICKHOUSE_ADDR=clickhouse:9000
CLICKHOUSE_DATABASE=ecommerce
CLICKHOUSE_USERNAME=dragon
CLICKHOUSE_PASSWORD=dragon_knight
# JDBC URL (HTTP port 8123) consumed by stats-reader/writer/backfill and the
# order/transaction stats RPCs.
CLICKHOUSE_URL=jdbc:clickhouse://clickhouse:8123/ecommerce
# stats_reader gRPC server binds grpc.server.port=9121; apigateway dials it via
# GRPC_STATS_READER_ADDR (legacy; the gateway currently routes stats through the
# order/transaction *.stats RPCs instead).
STATS_READER_LISTEN_ADDR=:9121
GRPC_STATS_READER_ADDR=stats_reader:9121
GRPC_STATS_READER_PORT=9121

GRPC_AUTH_PORT=50051
GRPC_ROLE_PORT=50052
GRPC_USER_PORT=50053
GRPC_CATEGORY_PORT=50054
GRPC_MERCHANT_PORT=50055
GRPC_ORDER_ITEM_PORT=50056
GRPC_ORDER_PORT=50057
GRPC_PRODUCT_PORT=50058
GRPC_TRANSACTION_PORT=50059
GRPC_CART_PORT=50060
GRPC_REVIEW_PORT=50061
GRPC_SLIDER_PORT=50062
GRPC_SHIPPING_PORT=50063
GRPC_BANNER_PORT=50064
GRPC_MERCHANT_AWARD_PORT=50065
GRPC_MERCHANT_BUSINESS_PORT=50066
GRPC_MERCHANT_DETAIL_PORT=50067
GRPC_MERCHANT_POLICY_PORT=50068
GRPC_REVIEW_DETAIL_PORT=50069

REDIS_DB_AUTH=0
REDIS_DB_ROLE=1
REDIS_DB_USER=2
REDIS_DB_CATEGORY=3
REDIS_DB_MERCHANT=4
REDIS_DB_ORDER_ITEM=5
REDIS_DB_ORDER=6
REDIS_DB_PRODUCT=7
REDIS_DB_TRANSACTION=8
REDIS_DB_CART=9
REDIS_DB_REVIEW=10
REDIS_DB_SLIDER=11
REDIS_DB_SHIPPING_ADDRESS=12
REDIS_DB_BANNER=13
REDIS_DB_MERCHANT_AWARD=14
REDIS_DB_MERCHANT_BUSINESS=15
REDIS_DB_MERCHANT_DETAIL=16

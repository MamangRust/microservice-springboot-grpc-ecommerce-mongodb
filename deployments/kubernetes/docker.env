APP_ENV=docker

# Satu instance MongoDB; DB per-context sebagai database terpisah.
# Tiap microservice membaca <MODULE>_DB_HOST/_PORT/_NAME di instance yang sama.
DB_MIGRATE_HOST=mongo
DB_MIGRATE_PORT=27017
DB_MIGRATE_NAME=ec_identity

# identity context → ec_identity
ROLE_DB_HOST=mongo
ROLE_DB_PORT=27017
ROLE_DB_NAME=ec_identity
